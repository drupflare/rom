# http://editorconfig.org
root = true

[*]
indent_style = tab
indent_size = 4
tab_width = 4
max_line_length = 100
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.neon]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
indent_style = space
max_line_length = off
