{
	"name": "@drupflare/rom",
	"version": "0.2.0",
	"private": true,
	"description": "Tooling only. The published artifact is the composer package drupflare/rom.",
	"scripts": {
		"prettier": "prettier --write .",
		"prettier:check": "prettier --check .",
		"docs": "./vendor/bin/phpdoc -d src -t docs --title=\"drupflare/rom\" --template=\"clean\" && cp .phpdoc/template/favicon.png docs/favicon.png && cp .phpdoc/template/favicon.ico docs/favicon.ico && bash phpdoc-favicon.sh",
		"lint": "php tests/lint.php",
		"test": "php tests/run-driver-suite.php",
		"test:installer": "php tests/run-installer.php",
		"test:pdo": "php tests/pdo-shim.php",
		"test:coverage": "php tests/coverage.php",
		"analyze": "./vendor/bin/phpstan analyse --memory-limit=1G",
		"prepare": "husky",
		"lint:php": "./vendor/bin/phpcs",
		"lint:php:fix": "./vendor/bin/phpcbf"
	},
	"devDependencies": {
		"@prettier/plugin-php": "^0.25.0",
		"@prettier/plugin-xml": "^3.4.2",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.9.6",
		"prettier-plugin-sh": "^0.19.0"
	},
	"lint-staged": {
		"*.{md,json,yml}": "prettier --write",
		"*.{php,module,install,inc}": [
			"./vendor/bin/phpcs --",
			"php tests/lint.php"
		]
	}
}
